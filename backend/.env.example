# Speech to text: scribe (ElevenLabs) or whisper (self-hosted)
STT_PROVIDER=scribe
FALLBACK_TO_WHISPER=true
SCRIBE_MODEL=scribe_v1
ELEVENLABS_API_KEY=

# large-v3-turbo for real use; small for fast local testing on CPU
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speech to document (any OpenAI-compatible API; Groq by default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

MAX_UPLOAD_MB=100
MAX_DURATION_MIN=30
ALLOWED_ORIGINS=http://localhost:5173
